{
  "ConnectionStrings": {
    //"defaultConnection": "server=DEV-AHMEDM;database=OrdersDb; Integrated Security=true;",
    "defaultConnection": "Server=${DB_HOST:-localhost},${DB_PORT:-1433};Database=${DB_NAME:-OrderDb};User Id=${DB_USER:-sa};Password=${DB_PASSWORD:-P@ssword123};"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "EventBus": {
    "HostName": "${RABBITMQ_HOST:-localhost}",
    "UserName": "${RABBITMQ_USER:-guest}",
    "Password": "${RABBITMQ_PASSWORD:-guest}"
  }
}
