{
  "ConnectionStrings": {
    "Redis": "${REDIS_HOST:-localhost}:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "EventBus": {
    "HostName": "${RABBITMQ_HOST:-localhost}",
    "UserName": "${RABBITMQ_USER:-guest}",
    "Password": "${RABBITMQ_PASSWORD:-guest}"
  }
}
