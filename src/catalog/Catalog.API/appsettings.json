{

  //connection string section


  "CatalogDatabaseSettings": {
    "ConnectionString": "${MONGODB_CONNECTION:-mongodb://localhost:27017}",
    "DatabaseName": "${MONGODB_DATABASE:-CatalogDb}",
    "CollectionName": "${MONGODB_COLLECTION:-Products}"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
